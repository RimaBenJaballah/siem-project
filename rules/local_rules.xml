<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

  <rule id="100200" level="5">
    <location>/var/log/opnsense-remote.log</location>
    <match>OPNsense</match>
    <description>OPNsense syslog message received</description>
  </rule>

  <rule id="100201" level="10">
    <if_sid>100200</if_sid>
    <match>filterlog</match>
    <description>OPNsense firewall log (filterlog)</description>
  </rule>

  <rule id="100202" level="12">
    <if_sid>100200</if_sid>
    <match>suricata</match>
    <description>OPNsense Suricata event</description>
  </rule>
</group>
